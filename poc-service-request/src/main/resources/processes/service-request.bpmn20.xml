<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.flowable.org/processdef">

  <process id="serviceRequestApproval" name="Service Request Approval" isExecutable="true">

    <startEvent id="startEvent" name="Start"/>

    <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="approvalTask"/>

    <userTask id="approvalTask" name="Approval" flowable:assignee="${approver}"/>

    <boundaryEvent id="timeoutBoundary" name="Timeout" attachedToRef="approvalTask" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration>PT1M</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>

    <sequenceFlow id="flowTimeout" sourceRef="timeoutBoundary" targetRef="approvedEnd"/>

    <exclusiveGateway id="decisionGateway"/>

    <sequenceFlow id="flowApproved" sourceRef="approvalTask" targetRef="decisionGateway">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == true}]]></conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="flowRejected" sourceRef="approvalTask" targetRef="rejectedEnd">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == false}]]></conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="flowToApproved" sourceRef="decisionGateway" targetRef="approvedEnd"/>

    <endEvent id="approvedEnd" name="Approved"/>
    <endEvent id="rejectedEnd" name="Rejected"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="serviceRequestApproval">

      <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
        <dc:Bounds x="120" y="122" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="128" y="165" width="20" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="approvalTask_di" bpmnElement="approvalTask">
        <dc:Bounds x="210" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="timeoutBoundary_di" bpmnElement="timeoutBoundary">
        <dc:Bounds x="252" y="162" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="290" y="174" width="42" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="decisionGateway_di" bpmnElement="decisionGateway" isMarkerVisible="true">
        <dc:Bounds x="370" y="120" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="approvedEnd_di" bpmnElement="approvedEnd">
        <dc:Bounds x="490" y="122" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="489" y="165" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="rejectedEnd_di" bpmnElement="rejectedEnd">
        <dc:Bounds x="490" y="262" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="489" y="305" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="156" y="140"/>
        <di:waypoint x="210" y="140"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flowTimeout_di" bpmnElement="flowTimeout">
        <di:waypoint x="270" y="198"/>
        <di:waypoint x="270" y="260"/>
        <di:waypoint x="330" y="290"/>
        <di:waypoint x="490" y="280"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flowApproved_di" bpmnElement="flowApproved">
        <di:waypoint x="310" y="140"/>
        <di:waypoint x="370" y="140"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flowRejected_di" bpmnElement="flowRejected">
        <di:waypoint x="310" y="180"/>
        <di:waypoint x="330" y="260"/>
        <di:waypoint x="400" y="280"/>
        <di:waypoint x="490" y="280"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flowToApproved_di" bpmnElement="flowToApproved">
        <di:waypoint x="410" y="140"/>
        <di:waypoint x="490" y="140"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
